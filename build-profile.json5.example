{
  // 模板：真实 build-profile.json5 不入库（含签名密码与本机证书路径）。
  // 首次构建前：
  //   cp build-profile.json5.example build-profile.json5
  // 再用 DevEco Studio 的 Project Structure → Signing Configs 生成调试签名，
  // 或手工把 signingConfigs 填成自己的证书。留空也能构建，只是产物未签名。
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // target 升到 API 26：沉浸光感（targetSdkVersion >= 26.0.0 才生效）。
        // API 26 起 targetSdkVersion 采用不带括号的语义化版本号写法。
        // compatible 保持 6.1.1(24)：老设备仍可安装，26 的新接口由
        // deviceInfo.apiAvailable('26.0.0') 在运行时做兼容保护并降级。
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      // 设备内原生执行核（IEC）。vendored 在 third_party/bettersh 下，作为本地
      // 模块参与构建；entry 通过 oh-package 的 file: 依赖使用它的 ArkTS 入口。
      "name": "iec",
      "srcPath": "./third_party/bettersh/iec/platform/ohos/har"
    }
  ]
}
