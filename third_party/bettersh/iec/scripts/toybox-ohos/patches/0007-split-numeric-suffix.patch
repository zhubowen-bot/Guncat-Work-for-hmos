+      if (FLAG(d)) {
+        // GNU 的 -d：后缀从 00 开始的定长十进制。前缀已经是跳过后缀的
+        // 模板，这里只把最后 TT.a 个占位符改成数字。
+        for (i = 0; i<TT.a; i++) {
+          *(--s) = '0'+(j%10);
+          j /= 10;
+        }
+      } else {
+        for (i = 0; i<TT.a; i++) {
+          *(--s) = 'a'+(j%26);
+          j /= 26;
+        }
       }
       if (j) error_exit("bad suffix");
       bytesleft = TT.b + ((filenum == TT.n) ? st.st_size%TT.n : 0);
