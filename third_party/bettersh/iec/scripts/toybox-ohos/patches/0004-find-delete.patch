--- a/toys/posix/find.c
+++ b/toys/posix/find.c
@@ -302,8 +302,11 @@ static int do_find(struct dirtree *new)
 
     if (!strcmp(s, "xdev")) TT.xdev = 1;
     else if (!strcmp(s, "delete")) {
