+// IEC refuses kill(-pgid, sig) with EINVAL, and timeout's local children can
+// leave that group: the inner timeout in `timeout 1 timeout 5 sleep 4` calls
+// setpgid(0,0) for its own child, which then holds the caller's stdout. Walk
+// /proc and signal the whole local descendant tree by positive pid; the job
+// signal below still covers the remote programs. Parent links are real for
+// these local toybox forks even though exec-spawned programs are flat, so a
+// bounded ppid cascade catches the nested groups too.
+#define KILL_LOCAL_MAX 512
+static void kill_local_group(pid_t root, int sig)
+{
+  struct local_proc { pid_t pid, ppid, pgrp; } procs[KILL_LOCAL_MAX];
+  int mark[KILL_LOCAL_MAX] = {0};
+  int n = 0, any = 0, changed;
+  DIR *d = opendir("/proc");
+
+  if (!d) {
+    kill(-root, sig);
+    return;
+  }
+  for (struct dirent *e; (e = readdir(d));) {
+    char path[64], buf[1024];
+    long pid, ppid, pgrp;
+    char *p;
+
+    if (e->d_name[0] < '0' || e->d_name[0] > '9') continue;
+    snprintf(path, sizeof(path), "/proc/%s/stat", e->d_name);
+    FILE *f = fopen(path, "r");
+    if (!f) continue;
+    if (!fgets(buf, sizeof(buf), f)) {
+      fclose(f);
+      continue;
+    }
+    fclose(f);
+    // The comm field may contain spaces or parentheses; parse after the last ')'.
+    if (!(p = strrchr(buf, ')'))) continue;
+    if (sscanf(p+1, " %*c %ld %ld", &ppid, &pgrp) != 2) continue;
+    if (n < KILL_LOCAL_MAX) {
+      pid = atoi(e->d_name);
+      procs[n].pid = (pid_t)pid;
+      procs[n].ppid = (pid_t)ppid;
+      procs[n].pgrp = (pid_t)pgrp;
+      n++;
+    }
+  }
+  closedir(d);
+
+  // Start from the root itself, its group, and its immediate children, then
+  // follow parent links until no new descendant is found. The child does not
+  // always lead its own group (nested timeout / failed setpgid): use the
+  // root's effective group as well, but never signal timeout itself.
+  const pid_t root_group = getpgid(root) > 0 ? getpgid(root) : root;
+  for (int i = 0; i < n; i++)
+    if (procs[i].pid == root || procs[i].pgrp == root ||
+        procs[i].pgrp == root_group || procs[i].ppid == root) mark[i] = 1;
+  do {
+    changed = 0;
+    for (int i = 0; i < n; i++) {
+      if (mark[i]) continue;
+      for (int j = 0; j < n; j++) {
+        if (mark[j] && procs[i].ppid == procs[j].pid) {
+          mark[i] = 1;
+          changed = 1;
+          break;
+        }
+      }
+    }
+  } while (changed);
+
+  for (int i = 0; i < n; i++)
+    if (mark[i] && procs[i].pid != getpid() && kill(procs[i].pid, sig) == 0)
+      any = 1;
+  if (!any) kill(-root, sig);
+}
+
 static void callback(char *argv[])
 {
-  if (!FLAG(foreground)) setpgid(0, 0);
+  // A nested timeout stays in the outer command's process group. It must not
+  // create a new group: the outer deadline then reaches the inner timeout and
+  // its children as one local tree (see kill_local_group()).
+  if (!FLAG(foreground) && !TT.nested) setpgid(0, 0);
+  // Only the command tree moves to the sub-job; timeout itself stays in the
+  // outer job so a tool-level cancel still reaches it.
+  if (TT.subjob) setenv("IEC_JOB", TT.subjob, 1);
 }
 
