+// GNU sort -h：按 1024 进制解析 "2K"/"1.5M"/"3G" 这类人类可读数字。
+// 没有后缀时就是普通数字；尾随的 "B"/"iB" 忽略。单位与 du -h 一致。
+static double human_number(char *s)
+{
+  char *end;
+  double v = strtod(s, &end);
+  int shift = 0;
+
+  switch (*end) {
+    case 'k': case 'K': shift = 1; break;
+    case 'm': case 'M': shift = 2; break;
+    case 'g': case 'G': shift = 3; break;
+    case 't': case 'T': shift = 4; break;
+    case 'p': case 'P': shift = 5; break;
+    case 'e': case 'E': shift = 6; break;
+    case 'z': case 'Z': shift = 7; break;
+    case 'y': case 'Y': shift = 8; break;
+  }
+  while (shift--) v *= 1024;
+  return v;
+}
