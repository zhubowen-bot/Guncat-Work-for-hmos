+// Replace every occurrence of pat in src with rep. The caller owns the result;
+// a missing pat is copied verbatim so the caller can decide whether to append
+// the input line instead.
+static char *replace_all(const char *src, const char *pat, const char *rep)
+{
+  size_t plen = strlen(pat), rlen = strlen(rep), n = 0;
+  const char *p = src, *q;
+  char *out, *d;
+
+  if (!plen) return xstrdup(src);
+  while ((p = strstr(p, pat))) { n++; p += plen; }
+  if (!n) return xstrdup(src);
+  out = d = xmalloc(strlen(src) - n*plen + n*rlen + 1);
+  for (p = src; (q = strstr(p, pat)); p = q + plen) {
+    size_t l = q - p;
+    memcpy(d, p, l); d += l;
+    memcpy(d, rep, rlen); d += rlen;
+  }
+  strcpy(d, p);
+  return out;
+}
