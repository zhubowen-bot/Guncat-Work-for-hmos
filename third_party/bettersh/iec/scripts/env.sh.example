# iec/scripts/env.sh.example — machine-local settings for the IEC build scripts.
#
# Copy this file to scripts/env.sh and adjust it for the host. env.sh is git-ignored;
# the scripts fall back to this example when env.sh is absent, so a fresh clone
# can build with the defaults on a standard DevEco installation.

# IEC_ROOT is this file's directory; PARENT is the tree that carries the
# third-party build outputs (zlib/pcre2/openssl/libcurl) used by the git build.
IEC_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PARENT="$(cd "$IEC_ROOT/.." && pwd)"
export IEC_ROOT PARENT

# OHOS toolchain.
OHOS_SDK="${OHOS_SDK:-/apps/harmony/sdk/default/openharmony}"
CLANG="${CLANG:-$OHOS_SDK/native/llvm/bin/clang}"
CLANG_DIR="${CLANG_DIR:-$(dirname "$CLANG")}"
CLANGXX="${CLANGXX:-$CLANG_DIR/clang++}"
TARGET="${TARGET:-aarch64-linux-ohos}"
SYSROOT="${SYSROOT:-$OHOS_SDK/native/sysroot}"
NATIVE_ARCH="${NATIVE_ARCH:-arm64-v8a}"
JOBS="${JOBS:-$(nproc)}"
export OHOS_SDK CLANG CLANG_DIR CLANGXX TARGET SYSROOT NATIVE_ARCH JOBS

# node/python keep their build trees and source caches inside the IEC tree.
# Set these only when reusing a build tree from another checkout.
IEC_SOURCE_CACHE="${IEC_SOURCE_CACHE:-$IEC_ROOT/thirdparty}"
IEC_NODE_BUILD="${IEC_NODE_BUILD:-$IEC_ROOT/build/node}"
IEC_PYTHON_BUILD="${IEC_PYTHON_BUILD:-$IEC_ROOT/build/python}"
IEC_PYTHON_PREFIX="${IEC_PYTHON_PREFIX:-/data/storage/el2/base/files/python}"
# Optional GNU musl toolchain that provides libatomic.a for node's link.
IEC_MUSL_TOOLCHAIN="${IEC_MUSL_TOOLCHAIN:-}"
# Optional source overrides for python's ncurses/libffi dependencies.
IEC_NCURSES_SRC="${IEC_NCURSES_SRC:-}"
IEC_LIBFFI_SRC="${IEC_LIBFFI_SRC:-}"
export IEC_SOURCE_CACHE IEC_NODE_BUILD IEC_PYTHON_BUILD IEC_PYTHON_PREFIX
export IEC_MUSL_TOOLCHAIN IEC_NCURSES_SRC IEC_LIBFFI_SRC

# Static third-party libraries used by the git build. They are built by the
# individual scripts under scripts/optional/ into this tree when missing.
IEC_DEPS_DIR="${IEC_DEPS_DIR:-$IEC_ROOT/build/sysroot}"
IEC_DEPS_LIB="${IEC_DEPS_LIB:-$IEC_DEPS_DIR/usr/lib/$TARGET}"
IEC_DEPS_INC="${IEC_DEPS_INC:-$IEC_DEPS_DIR/usr/include}"
IEC_OPENSSL_DIR="${IEC_OPENSSL_DIR:-$IEC_ROOT/build/openssl}"
IEC_CURL_DIR="${IEC_CURL_DIR:-$IEC_ROOT/build/curl}"
export IEC_DEPS_DIR IEC_DEPS_LIB IEC_DEPS_INC IEC_OPENSSL_DIR IEC_CURL_DIR

# Sources for the git dependencies. They are downloaded or cloned into
# $IEC_THIRDPARTY when a dependency script needs them.
IEC_THIRDPARTY="${IEC_THIRDPARTY:-$IEC_ROOT/thirdparty}"
IEC_ZLIB_VER="${IEC_ZLIB_VER:-1.3.1}"
IEC_ZLIB_URL="${IEC_ZLIB_URL:-https://github.com/madler/zlib/releases/download/v$IEC_ZLIB_VER/zlib-$IEC_ZLIB_VER.tar.gz}"
IEC_LIBARCHIVE_VER="${IEC_LIBARCHIVE_VER:-3.7.7}"
IEC_LIBARCHIVE_URL="${IEC_LIBARCHIVE_URL:-https://libarchive.org/downloads/libarchive-$IEC_LIBARCHIVE_VER.tar.xz}"
IEC_PCRE2_REPO="${IEC_PCRE2_REPO:-https://github.com/PCRE2Project/pcre2.git}"
IEC_OPENSSL_VER="${IEC_OPENSSL_VER:-3.0.22}"
IEC_OPENSSL_URL="${IEC_OPENSSL_URL:-https://codeload.github.com/openssl/openssl/tar.gz/refs/tags/openssl-$IEC_OPENSSL_VER}"
IEC_CURL_VER="${IEC_CURL_VER:-8.22.0}"
IEC_CURL_URL="${IEC_CURL_URL:-https://curl.se/download/curl-$IEC_CURL_VER.tar.gz}"
export IEC_THIRDPARTY IEC_ZLIB_VER IEC_ZLIB_URL IEC_LIBARCHIVE_VER IEC_LIBARCHIVE_URL IEC_PCRE2_REPO
export IEC_OPENSSL_VER IEC_OPENSSL_URL IEC_CURL_VER IEC_CURL_URL

# Sources are cloned into $IEC_ROOT/thirdparty when the build script cannot
# find a checkout. The trees are git-ignored.
IEC_MKSH_REPO="${IEC_MKSH_REPO:-https://gitcode.com/openharmony/third_party_mksh.git}"
IEC_TOYBOX_REPO="${IEC_TOYBOX_REPO:-https://github.com/landley/toybox.git}"
IEC_DROPBEAR_REPO="${IEC_DROPBEAR_REPO:-https://github.com/mkj/dropbear.git}"
IEC_GIT_REPO="${IEC_GIT_REPO:-https://github.com/git/git.git}"
export IEC_MKSH_REPO IEC_TOYBOX_REPO IEC_DROPBEAR_REPO IEC_GIT_REPO

# Optional HTTPS proxy for the clones. Empty uses the environment's proxy.
# Example: IEC_PROXY=http://172.17.192.1:7890
IEC_PROXY="${IEC_PROXY:-}"
if [ -n "$IEC_PROXY" ]; then
	export https_proxy="$IEC_PROXY"
	export http_proxy="$IEC_PROXY"
fi
export IEC_PROXY
