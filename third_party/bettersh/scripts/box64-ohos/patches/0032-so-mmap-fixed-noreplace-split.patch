+        } else {
+            ret = fb_ret;
+            e = (fb_ret == MAP_FAILED) ? fb_e : 0;
         }
+    } else {
+        /* 真分配: MAP_FIXED 要么成功拿到 addr 要么真失败, 不再判 conflict */
+        ret = fb_ret;
+        e = (fb_ret == MAP_FAILED) ? fb_e : 0;
     }
-    /* OHOS_PATCH_MMAP_NOREPLACE_FALLBACK END */
+    errno = e;
+}
+/* OHOS_PATCH_MMAP_NOREPLACE_V2 END */
