+/* aarch64 上原本没有 my_ioctl（上游那份被 #ifdef PPC64LE 包着，只管做 PPC 的 _IOC
+ * 位域转换），ioctl 是直通宿主的。这里补一个：先问 tty shim（winsize/前台组/termios
+ * 这些"会话状态"请求），其余原样落宿主。 */
+EXPORT int my_ioctl(x64emu_t* emu, int fd, unsigned long req, void* arg)
+{
+    (void)emu;
+    return bsh_tty_ioctl(fd, (int)req, arg);
+}
+#endif
