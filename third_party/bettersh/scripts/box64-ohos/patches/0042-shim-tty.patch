+EXPORT int my_isatty(x64emu_t* emu, int fd)
+{
+    (void)emu;
+    return bsh_tty_isatty(fd);
+}
+
+EXPORT int my_tcgetattr(x64emu_t* emu, int fd, struct termios* t)
+{
+    (void)emu;
+    return bsh_tty_tcgetattr(fd, t);
+}
+
+EXPORT int my_tcsetattr(x64emu_t* emu, int fd, int when, const struct termios* t)
+{
+    (void)emu;
+    return bsh_tty_tcsetattr(fd, when, t);
+}
