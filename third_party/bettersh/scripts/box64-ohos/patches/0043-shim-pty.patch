 #endif
+
+/* ── OHOS_PATCH_SHIM_PTY ────────────────────────────────────────────────────
+ * 沙箱三层都打不开真 /dev/ptmx（EACCES），所以"能拿到 pty"只有用户态假 pts 一条路
+ * （socketpair 当 master/slave + 一张 fd→pts 表）。elfloader 的 guest shim 一直这么干，
+ * 这里让 box64 guest 走同一份实现（-DBSH_SHIM_PREFIX=bsh_pty_ 编进来）。
+ *
+ * 上面这几个入口的接线在前两轮就铺好了：open(/dev/ptmx)、open(/dev/pts/N)、
+ * isatty/tcgetattr/ioctl(TIOCSCTTY) 都已经经 tty shim 转到 pty 模块；这里补的是
+ * 剩下那几个"名字就是 API"的：grantpt/unlockpt/ptsname(_r)/ttyname(_r)/close。
+ * 表项从 GO/GOW 改成 GOM，否则它们直通宿主，对假 master 只会报 ENOTTY。 */
+EXPORT int my_grantpt(x64emu_t* emu, int fd)          { (void)emu; return bsh_pty_grantpt(fd); }
+EXPORT int my_unlockpt(x64emu_t* emu, int fd)         { (void)emu; return bsh_pty_unlockpt(fd); }
+EXPORT char* my_ptsname(x64emu_t* emu, int fd)        { (void)emu; return bsh_pty_ptsname(fd); }
+EXPORT int my_ptsname_r(x64emu_t* emu, int fd, char* buf, size_t n)
+{ (void)emu; return bsh_pty_ptsname_r(fd, buf, n); }
+EXPORT char* my_ttyname(x64emu_t* emu, int fd)        { (void)emu; return bsh_tty_ttyname(fd); }
+EXPORT int my_ttyname_r(x64emu_t* emu, int fd, char* buf, size_t n)
+{ (void)emu; return bsh_tty_ttyname_r(fd, buf, n); }
+EXPORT int my_close(x64emu_t* emu, int fd)
+{
+    (void)emu;
+    /* 关掉假 pts 的 master 时要顺带回收它攥着的 slave 端（shim 的 close 干这个），
+     * 否则对端读不到 EOF。不是假 pts 的 fd 原样落宿主 close。 */
+    return bsh_pty_close(fd);
+}
 /* OHOS_PATCH_PATH_REMAP_V2 END */
 
