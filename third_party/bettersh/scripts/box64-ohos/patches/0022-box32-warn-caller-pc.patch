diff --git a/src/include/box32.h b/src/include/box32.h
index e7eb5477c..ffd7539e8 100644
--- a/src/include/box32.h
+++ b/src/include/box32.h
@@ -1,3 +1,4 @@
+/* OHOS_PATCH_BOX32_WARN_CALLER */
 #ifndef __BOX32_64__H_
 #define __BOX32_64__H_
 
@@ -32,47 +33,47 @@ uintptr_t from_hash_d(ulong_t l);
 #include "debug.h"
 void box64_abort();
 
-static inline ptr_t to_ptr(uintptr_t p) {
+static __attribute__((noinline)) ptr_t to_ptr(uintptr_t p) {
     if(p!=0xffffffffffffffffLL && (p>>32)) {
-        printf_log(LOG_NONE, "Warning, uintptr_t %p is not a 32bits value\n", (void*)p);
+        printf_log(LOG_NONE, "Warning, uintptr_t %p is not a 32bits value (caller=%p)\n", (void*)p, __builtin_return_address(0));
         #ifdef TEST_ABORT
         box64_abort();
         #endif
     }
     return (ptr_t)p;
 }
-static inline ptr_t to_ptrv(void* p2) {
+static __attribute__((noinline)) ptr_t to_ptrv(void* p2) {
     uintptr_t p = (uintptr_t)p2;
     if(p!=0xffffffffffffffffLL && (p>>32)) {
-        printf_log(LOG_NONE, "Warning, pointer %p is not a 32bits value\n", p2);
+        printf_log(LOG_NONE, "Warning, pointer %p is not a 32bits value (caller=%p)\n", p2, __builtin_return_address(0));
         #ifdef TEST_ABORT
         box64_abort();
         #endif
     }
     return (ptr_t)p;
 }
-static inline long_t to_long(long long l) {
+static __attribute__((noinline)) long_t to_long(long long l) {
     long_t ret = (long_t)l;
     if(l!=ret)
-        printf_log(LOG_NONE, "Warning, long %ld is not a 32bits value\n", l);
+        printf_log(LOG_NONE, "Warning, long %ld is not a 32bits value (caller=%p)\n", l, __builtin_return_address(0));
     return ret;
 }
-static inline ulong_t to_ulong(unsigned long long l) {
+static __attribute__((noinline)) ulong_t to_ulong(unsigned long long l) {
     if(l!=0xffffffffffffffffLL && (l>>32))
-        printf_log(LOG_NONE, "Warning, ulong %p is not a 32bits value\n", (void*)l);
+        printf_log(LOG_NONE, "Warning, ulong %p is not a 32bits value (caller=%p)\n", (void*)l, __builtin_return_address(0));
     return (ulong_t)l;
 }
 #else //TEST32
-static inline ptr_t to_ptr(uintptr_t p) {
+static __attribute__((noinline)) ptr_t to_ptr(uintptr_t p) {
     return (ptr_t)p;
 }
-static inline ptr_t to_ptrv(void* p) {
+static __attribute__((noinline)) ptr_t to_ptrv(void* p) {
     return (ptr_t)(uintptr_t)p;
 }
-static inline long_t to_long(long long l) {
+static __attribute__((noinline)) long_t to_long(long long l) {
     return (long_t)l;
 }
-static inline ulong_t to_ulong(unsigned long long l) {
+static __attribute__((noinline)) ulong_t to_ulong(unsigned long long l) {
     return (ulong_t)l;
 }
 #endif //TEST32
