#!/bin/bash
# env.sh — Better 构建公共环境变量（被所有构建脚本 source，不要直接执行）
set -euo pipefail

# ── 根目录 ──────────────────────────────────────────────
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export ROOT

# ── Build profile 目录 ──────────────────────────────────
export BUILD_PROFILE_FILE="${BUILD_PROFILE_FILE:-/mnt/c/myws/hm/BetterSH/build-profile.json5}"

# ── OHOS SDK / 命令行工具 ────────────────────────────────
# 默认 /apps/harmony（DevEco command-line-tools 布局），可用 OHOS_SDK/TOOL_HOME 覆盖
export TOOL_HOME="${TOOL_HOME:-/apps/harmony}"
export OHOS_SDK="${OHOS_SDK:-$TOOL_HOME/sdk/default/openharmony}"
export PATH="$TOOL_HOME/bin:$TOOL_HOME/tool/node/bin:$PATH"

export HDC="/mnt/c/Program Files/Huawei/DevEco Studio/sdk/default/openharmony/toolchains/hdc.exe"
export DEVICE_SN="${DEVICE_SN:-}"          # 目标设备序列号(空 = hdc 默认设备)
export BUNDLE_NAME="${BUNDLE_NAME:-com.yiyan.bettersh}"
export ENTRY_ABILITY="${ENTRY_ABILITY:-EntryAbility}"

# 防 SDK toolchains 劫持系统工具：鸿蒙自带 diff 行为异常（对不存在的文件也返回 0），
# 会破坏 autotools 的 config.status

CLANG_DIR="$OHOS_SDK/native/llvm/bin"
export CLANG="$CLANG_DIR/clang"
export CLANGXX="$CLANG_DIR/clang++"
export SYSROOT="$OHOS_SDK/native/sysroot"

# ── Native 层架构（HAP .so 目标）─────────────────────────
# arm64-v8a: 真机；x86_64: 模拟器
NATIVE_ARCH="${NATIVE_ARCH:-arm64-v8a}"
case "$NATIVE_ARCH" in
  arm64-v8a) TARGET="aarch64-linux-ohos" ; HOST_TRIPLE="aarch64-linux-gnu" ;;
  x86_64)    TARGET="x86_64-linux-ohos"  ; HOST_TRIPLE="x86_64-linux-gnu" ;;
  *) echo "ERROR: NATIVE_ARCH=$NATIVE_ARCH 不支持（arm64-v8a / x86_64）" >&2; exit 1 ;;
esac
export NATIVE_ARCH TARGET HOST_TRIPLE

# ── 构建目录 ─────────────────────────────────────────────
export BUILD_DIR="$ROOT/build"
export HOST_TOOLS="$BUILD_DIR/host-tools"          # 宿主 wayland-scanner 等
export SYSROOT_EXT="$BUILD_DIR/sysroot-ext-$NATIVE_ARCH"  # 交叉编译扩展（libffi/wayland 安装根）
export SYSROOT_EXT_INC="$SYSROOT_EXT/usr/include"
export SYSROOT_EXT_LIB="$SYSROOT_EXT/usr/lib/$TARGET"      # 与 winehua 布局一致（含 target 子目录）
export SYSROOT_EXT_PC="$SYSROOT_EXT/usr/lib/pkgconfig"

# ── 源码目录 ─────────────────────────────────────────────
export WAYLAND_SRC="${WAYLAND_SRC:-$ROOT/thirdparty/wayland}"
export WAYLAND_PROTOCOLS_SRC="${WAYLAND_PROTOCOLS_SRC:-$ROOT/thirdparty/wayland-protocols}"
export LIBFFI_SRC="${LIBFFI_SRC:-$ROOT/thirdparty/libffi}"
export XDG_SHELL_XML="${XDG_SHELL_XML:-$WAYLAND_PROTOCOLS_SRC/stable/xdg-shell/xdg-shell.xml}"

# ── 产物目录 ─────────────────────────────────────────────
# 分包后：所有 .so / rawfile 资源都归共享 HAR(feature/bsh_main)，两个薄 entry 只放
# module.json5 + 页面壳，所以脚本侧"往包里放东西"的路径统一指 HAR。
export HAP_MODULE_DIR="$ROOT/feature/bsh_main"           # 共享 HAR 模块根
export HAP_LIBS_DIR="$HAP_MODULE_DIR/libs/$NATIVE_ARCH"  # 打进 HAP 的 .so
export HAP_RAWFILE_TOOLS_DIR="$HAP_MODULE_DIR/src/main/resources/rawfile/tools"
export CPP_INC_DIR="$HAP_MODULE_DIR/src/main/cpp/wayland/include"  # wayland 公共头/协议(生成)
# 具体构建哪个 entry：tablet(平板/2in1) 或 phone；产物落在 product/<名>/build/...
export BSH_PRODUCT="${BSH_PRODUCT:-tablet}"
export HAP_OUT_DIR="$ROOT/product/$BSH_PRODUCT/build/default/outputs/default"
export DIST_DIR="$ROOT/dist/$NATIVE_ARCH"              # 客户端 SDK 交付物
export WAYLAND_VERSION="1.22.0"

# 宿主 wayland-scanner（交叉编译时不需要扫描器目标库，只编 scanner）
export WAYLAND_SCANNER="${WAYLAND_SCANNER:-$HOST_TOOLS/bin/wayland-scanner}"

# 并行度
JOBS="${JOBS:-$(nproc 2>/dev/null || echo 4)}"
export JOBS

# ── 宿主机代理（WSL 访问外网；本机配置，未设置时自动探测）──
# 自动探测：WSL 网关 + Clash 默认端口 7890；可用 BSH_PROXY_HOST/PORT 覆盖
if [ -z "${http_proxy:-}${HTTP_PROXY:-}" ]; then
    _wm_proxy_host="${BSH_PROXY_HOST:-172.17.192.1}"
    _wm_proxy_port="${BSH_PROXY_PORT:-7890}"
    if timeout 2 bash -c "echo > /dev/tcp/$_wm_proxy_host/$_wm_proxy_port" 2>/dev/null; then
        export http_proxy="http://$_wm_proxy_host:$_wm_proxy_port"
        export https_proxy="$http_proxy"
        export HTTP_PROXY="$http_proxy" HTTPS_PROXY="$http_proxy"
        log "检测到宿主机代理: $http_proxy（所有下载走代理）"
    fi
    unset _wm_proxy_host _wm_proxy_port
fi

log()  { echo -e "\033[32m[BSH]\033[0m $*" >&2; }
warn() { echo -e "\033[33m[BSH]\033[0m $*" >&2; }
err()  { echo -e "\033[31m[BSH]\033[0m ERROR: $*" >&2; exit 1; }
