--- a/sysdeps/unix/sysv/linux/aarch64/clone3.S
+++ b/sysdeps/unix/sysv/linux/aarch64/clone3.S
@@ -40,6 +40,28 @@
 	PTR_ARG (1)
 	PTR_ARG (3)
 	PTR_ARG (4)
+	/* ── BetterSH / HarmonyOS ─────────────────────────────────────────
+	   这块沙箱的 seccomp 对 clone3(aarch64 = 435)**不给返回值,直接 SIGSYS**
+	   杀进程(实测 rc=159=128+31,逐号探针同样复现);而 glibc 2.39 起线程创建
+	   先试 clone3,于是动态 glibc guest 一进 pthread_create 就整只被打掉(别的
+	   用例都过,就这一条把它带走)。
+
+	   glibc 只在 clone3 返回 errno==ENOSYS 时才回退(见
+	   sysdeps/unix/sysv/linux/clone-internal.c 的 __clone3_internal):
+	   --enable-kernel=4.19 让 __ASSUME_CLONE3=0,所以走的是"首调失败即置
+	   clone3_supported=0"那条路。这里让 __clone3 连 syscall 都不发,直接按
+	   "内核不支持 clone3"返回 -1/ENOSYS —— 上层 __clone_internal 随即调
+	   __clone_internal_fallback → __clone(本目录 clone.S,aarch64 上是 220 号),
+	   线程创建照常。语义与老内核一致,也不再需要任何环境变量。
+
+	   为什么改本文件而不是同目录上层的 sysdeps/unix/sysv/linux/clone3.c:
+	   后者只是个空占位,真正参与编译、提供 __clone3 的是本文件(见
+	   build/glibc/make.log:aarch64/clone3.S → misc/clone3.o),改那个 .c 不生效
+	   (踩过)。
+
+	   本运行时只给这台设备编,所以"clone3 永不可用、一律走 clone"即预期行为。  */
+	mov	x0, #-ENOSYS
+	b	.Lsyscall_error
 	/* Save args for the child.  */
 	mov	x10, x0		/* cl_args  */
 	mov	x11, x2		/* func	 */
