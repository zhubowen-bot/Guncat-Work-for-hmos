#!/bin/sh
# Guncat Linux VM: 任务代理。
#
# 宿主(ArkTS)通过 virtio-9p 共享目录下发任务, 本脚本在 VM 内执行并把结果写回,
# 因此**不需要串口/SSH/QGA** —— 命令结果直接走共享目录回传, 延迟只有一个轮询周期。
#
# 目录协议(全部在 /mnt/guncat-ipc/<会话 id>/ 下):
#   in/<任务 id>/cmd       必填, shell 脚本正文(由 /bin/sh 执行)
#   in/<任务 id>/cwd       可选, 相对会话工作区的目录
#   in/<任务 id>/timeout   可选, 超时秒数(默认 60)
#   in/<任务 id>/stdin     可选, 标准输入内容
#   in/<任务 id>/ready     由宿主最后创建: 出现即表示请求完整, 可以执行
#   out/<任务 id>/stdout   标准输出
#   out/<任务 id>/stderr   标准错误
#   out/<任务 id>/code     退出码(超时为 137)
#   out/<任务 id>/done     出现即表示执行完毕
#
# 工作区一致性: /workspace 用 bind mount 指向 /mnt/workspaces/<会话 id>,
# 也就是应用侧 filesDir/workspaces/<会话 id> —— 与 read_file/write_file 看到的
# 是同一个目录(同一批 inode), 不是副本。
set -u

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export TERM=dumb
export LC_ALL=C.UTF-8

IPC=/mnt/guncat-ipc
WS=/mnt/workspaces
CUR=/run/guncat/workspace.current

mkdir -p /run/guncat

# 就绪标记: 宿主轮询它判断 VM 已经可用(也能看出是不是挂载失败)。
# 先写临时文件再 mv: 避免宿主读到写了一半的标记。
{
  echo "ready"
  echo "uname=$(uname -srm 2>/dev/null)"
  echo "sh=$(readlink -f /bin/sh 2>/dev/null)"
  echo "workspaces_mounted=$(grep -c ' /mnt/workspaces ' /proc/mounts 2>/dev/null)"
  echo "ipc_mounted=$(grep -c ' /mnt/guncat-ipc ' /proc/mounts 2>/dev/null)"
  echo "boot_seconds=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)"
} > "$IPC/.ready.tmp" 2>/dev/null
mv "$IPC/.ready.tmp" "$IPC/.ready" 2>/dev/null

# 会话工作区切换: 只在换会话时才重新 bind, 避免每次执行都 mount
bind_workspace() {
  conv="$1"
  if [ "$(cat "$CUR" 2>/dev/null)" = "$conv" ]; then
    return 0
  fi
  umount /workspace 2>/dev/null
  mkdir -p /workspace
  if mount --bind "$WS/$conv" /workspace 2>/dev/null; then
    echo "$conv" > "$CUR"
    return 0
  fi
  echo "guncat-agent: bind /workspace -> $WS/$conv failed" >&2
  return 1
}

run_job() {
  reqdir="$1"
  conv="$2"
  jobid="$3"
  out="$IPC/$conv/out/$jobid"
  mkdir -p "$out"

  # 认领: rename 是原子的, 避免同一个任务被执行两次
  mv "$reqdir/ready" "$reqdir/running" 2>/dev/null || return 0

  date +%s > "$out/started" 2>/dev/null

  bind_workspace "$conv"

  cwd=/workspace
  if [ -s "$reqdir/cwd" ]; then
    rel=$(cat "$reqdir/cwd" 2>/dev/null)
    case "$rel" in
      /*) cwd="$rel" ;;
      "") cwd=/workspace ;;
      *)  cwd="/workspace/$rel" ;;
    esac
  fi
  [ -d "$cwd" ] || cwd=/workspace

  tmo=60
  if [ -s "$reqdir/timeout" ]; then
    t=$(cat "$reqdir/timeout" 2>/dev/null)
    case "$t" in
      ''|*[!0-9]*) tmo=60 ;;
      *) tmo="$t" ;;
    esac
  fi
  [ "$tmo" -ge 1 ] 2>/dev/null || tmo=60
  [ "$tmo" -le 3600 ] 2>/dev/null || tmo=3600

  stdin_file=/dev/null
  [ -f "$reqdir/stdin" ] && stdin_file="$reqdir/stdin"

  (
    cd "$cwd" 2>/dev/null || cd /workspace
    export HOME=/root
    export TMPDIR=/tmp
    export PWD="$(pwd)"
    timeout -s KILL "$tmo" /bin/sh "$reqdir/cmd" < "$stdin_file"
  ) > "$out/stdout" 2> "$out/stderr"

  code=$?
  echo "$code" > "$out/code" 2>/dev/null
  date +%s > "$out/finished" 2>/dev/null
  : > "$out/done"
  rm -rf "$reqdir" 2>/dev/null
}

while :; do
  busy=0
  # 遍历所有会话的收件箱: 一份 VM 服务全部会话, 各会话工作区互不干扰
  for ready in "$IPC"/*/in/*/ready; do
    [ -f "$ready" ] || continue
    busy=1
    reqdir="${ready%/ready}"      # …/<会话>/in/<任务 id>
    jobid="${reqdir##*/}"
    in_dir="${reqdir%/*}"         # …/<会话>/in
    conv_dir="${in_dir%/*}"       # …/<会话>
    conv="${conv_dir##*/}"
    run_job "$reqdir" "$conv" "$jobid"
  done
  [ "$busy" -eq 0 ] && sleep 0.15
done
